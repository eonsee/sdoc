---
/**
 * PaginationLink — one side of the previous/next pair: a caret, a caption,
 * and the page title.
 */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"a">, "rel"> {
  rel: "prev" | "next";
  href: string;
  /** Caption above the title. Defaults to "Previous" or "Next". */
  label?: string;
}

const { rel, href, label, class: className, ...attrs } = Astro.props;
const isNext = rel === "next";
const caption = label ?? (isNext ? "Next" : "Previous");
---

<a
  href={href}
  rel={rel}
  data-nb-pagination-item
  data-slot="pagination-link"
  class={cn(
    "group flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground",
    isNext && "text-right",
    className,
  )}
  {...attrs}
>
  {!isNext && <Icon name="ph:caret-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5" />}
  <span>
    <span data-slot="pagination-label" class="block text-xs text-muted-foreground">{caption}</span>
    <span data-slot="pagination-title" class="font-medium text-foreground"><slot /></span>
  </span>
  {isNext && <Icon name="ph:caret-right" class="w-4 h-4 transition-transform group-hover:translate-x-0.5" />}
</a>

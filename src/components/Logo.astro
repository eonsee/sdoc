---
/* The site's mark. It lives in public/ so the favicon and social cards can use
   the same artwork; the header link's accessible name stays the site title. */
import { logo } from "./logo";

interface Props { class?: string }
const { class: cls = "h-7 w-7" } = Astro.props;
const src = `${import.meta.env.BASE_URL}${logo.file}`;
---
<img src={src} width={logo.width} height={logo.height} alt="" class={cls} aria-hidden="true" />
